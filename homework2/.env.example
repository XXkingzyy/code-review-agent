# ===== LLM 服务配置（复制本文件为 .env 后填入真实值）=====
# OpenAI 官方：https://api.openai.com/v1，模型名 gpt-4o-mini / gpt-4o
# DeepSeek：https://api.deepseek.com/v1，模型名 deepseek-chat
# 通义千问（DashScope 兼容模式）：https://dashscope.aliyuncs.com/compatible-mode/v1，模型名 qwen-plus
# 本地 Ollama：http://localhost:11434/v1，模型名 qwen2.5:7b（此时 KEY 随便填）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-在这里填你的Key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_RETRIES=3

# ===== Workflow 运行参数 =====
# 最大审查轮数（含首轮；每轮未通过会触发一次修复）
MAX_ROUNDS=3
# 通过阈值（0~10）：评分达到阈值且没有 critical 问题才算通过
PASS_THRESHOLD=8
# 代码执行工具的超时时间（秒）
CODE_EXEC_TIMEOUT=5
